# Copy this file to .env and fill in the key for the provider you use.

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama runs locally; change only if it is not on the default address.
# OLLAMA_HOST=http://localhost:11434

# Overrides llm.provider in config.yaml (gemini | claude | ollama)
# LLM_PROVIDER=gemini
